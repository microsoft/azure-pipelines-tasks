{
  "loc.friendlyName": "Gradle Authenticate",
  "loc.helpMarkDown": "[Learn more about this task](https://aka.ms/GradleAuthenticateTask)",
  "loc.description": "Authenticate Gradle builds against Azure Artifacts feeds using Workload Identity Federation or an access token.",
  "loc.instanceNameFormat": "Gradle Authenticate",
  "loc.input.label.buildFiles": "Build files",
  "loc.input.help.buildFiles": "Newline-separated list of Gradle build files to scan for Azure Artifacts repository URLs. Should include settings.gradle for plugin version discovery.",
  "loc.input.label.repositoryUrl": "Repository URL(s)",
  "loc.input.help.repositoryUrl": "Newline-separated list of explicit Azure Artifacts repository URLs to authenticate, in addition to any discovered from build files. Supports both dependency feeds and plugin repositories.",
  "loc.input.label.adoServiceConnection": "Service connection",
  "loc.input.help.adoServiceConnection": "Azure DevOps service connection for Workload Identity Federation (WIF). If omitted, the task uses the SYSTEM_ACCESSTOKEN or ARTIFACTS_GRADLE_AUTH_ACCESS_TOKEN environment variable for authentication.",
  "loc.input.label.pluginToolVersion": "Plugin tool version",
  "loc.input.help.pluginToolVersion": "Override the credential provider plugin version used for the local JAR layout and init script. Use when settings.gradle does not declare the plugin or when version resolution fails.",
  "loc.input.label.gradleUserHome": "Gradle user home",
  "loc.input.help.gradleUserHome": "Override the Gradle user home directory. Defaults to ~/.gradle. The init script is written to <gradleUserHome>/init.d/.",
  "loc.messages.Error_CouldNotDetermineVersion": "Could not determine the credential provider plugin version. Either declare the plugin in settings.gradle and include it in buildFiles, or set the pluginToolVersion input.",
  "loc.messages.Error_CouldNotResolveCiJar": "Could not resolve the credential provider JAR.",
  "loc.messages.Error_InvalidPluginVersion": "The plugin version is invalid. Use 1-64 letters, numbers, periods, plus signs, underscores, or hyphens.",
  "loc.messages.Error_NoBuildFilesOrRepoUrls": "At least one of buildFiles or repositoryUrl must be provided. buildFiles should list Gradle build files containing Azure Artifacts repository URLs. repositoryUrl should be an explicit Azure Artifacts repository URL.",
  "loc.messages.Error_NoCiJarFound": "No credential provider JAR found. Ensure GRADLE_CREDPROVIDER_HOME is set (provided automatically on Microsoft-hosted agents) or that the task package includes a bundled credential provider JAR.",
  "loc.messages.Info_AuthConfigWritten": "Auth config written.",
  "loc.messages.Info_AutoDiscoveredBuildFiles": "No buildFiles input provided; auto-discovered Gradle files in working directory: %s",
  "loc.messages.Info_CiJarFromBundled": "Using bundled credential provider JAR.",
  "loc.messages.Info_CiJarFromHome": "Using credential provider JAR from GRADLE_CREDPROVIDER_HOME.",
  "loc.messages.Info_CiJarResolved": "Credential provider JAR resolved.",
  "loc.messages.Info_DiscoveredFeed": "Discovered feed: %s (from %s)",
  "loc.messages.Info_DynamicVersionDetected": "Dynamic plugin version \"%s\" detected; will resolve via maven-metadata.xml.",
  "loc.messages.Info_EnvVarsSet": "Gradle authentication environment variables set.",
  "loc.messages.Info_FeedResourceTenant": "Feed resource tenant determined.",
  "loc.messages.Info_InitScriptWritten": "Init script written.",
  "loc.messages.Info_MavenRepoLaidOut": "Maven repository laid out.",
  "loc.messages.Info_NoFeedsNothingToConfigure": "No Azure Artifacts feeds found. Nothing to configure.",
  "loc.messages.Info_PluginVersionBundled": "No plugin version in build files; using bundled JAR version.",
  "loc.messages.Info_PluginVersionFromFile": "Plugin version from %s: %s",
  "loc.messages.Info_PluginVersionFromInput": "Plugin version from pluginToolVersion input: %s",
