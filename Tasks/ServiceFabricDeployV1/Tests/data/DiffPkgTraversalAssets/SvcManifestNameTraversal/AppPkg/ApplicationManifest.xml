<?xml version="1.0" encoding="utf-8"?>
<!-- Security test asset: ServiceManifestRef/@ServiceManifestName is a relative path traversal.
     Before the fix this name was joined onto both the application package path and the diff
     package path, so the manifest was read from - and the service package copied to - a location
     outside the package. -->
<ApplicationManifest xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ApplicationTypeName="TestType" ApplicationTypeVersion="2.0.0" xmlns="http://schemas.microsoft.com/2011/01/fabric">
  <Parameters>
    <Parameter Name="Stateless1_InstanceCount" DefaultValue="-1" />
  </Parameters>
  <ServiceManifestImport>
    <ServiceManifestRef ServiceManifestName="..\..\..\Evil" ServiceManifestVersion="2.0.0" />
    <ConfigOverrides />
  </ServiceManifestImport>
  <DefaultServices>
    <Service Name="Stateless1" ServicePackageActivationMode="ExclusiveProcess">
      <StatelessService ServiceTypeName="Stateless1Type" InstanceCount="[Stateless1_InstanceCount]">
        <SingletonPartition />
      </StatelessService>
    </Service>
  </DefaultServices>
</ApplicationManifest>
